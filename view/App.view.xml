<mvc:View
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    controllerName="myApp.controller.App">
    <App>
        <pages>
            <Page title="My Fiori App">
                <content>
                    <List items="{/items}">
                        <StandardListItem title="{name}" description="{description}"/>
                    </List>
                </content>
            </Page>
        </pages>
    </App>
</mvc:View>
